# Copy to terraform.tfvars (git-ignored) and fill in the real values.
# Look them up per repository with:
# gh api repos/abdurahim50/<repo>/actions/oidc/customization/sub
# The output looks like: repo:abdurahim50@<OWNER_ID>/<repo>@<REPO_ID>
github_owner_id               = "<OWNER_ID>"
github_repository_id          = "<ZEN_INFRA_REPO_ID>"
github_backend_repository_id  = "<ZEN_PHARMA_BACKEND_REPO_ID>"
github_frontend_repository_id = "<ZEN_PHARMA_FRONTEND_REPO_ID>"
